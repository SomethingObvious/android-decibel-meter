    <string name="settings">Settings</string>
    <string name="background_title">Keep measuring when I leave the app</string>
    <string name="background_detail">A notification shows the level and has a Stop button. Off, measuring pauses when you leave and picks up when you come back.</string>
    <string name="alert_title">Alert above a level</string>
    <string name="alert_detail">Buzzes once each time the level goes over, and ALERT stays lit until you tap it.</string>
